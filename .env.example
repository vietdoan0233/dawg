# Copy to .env.local (never commit it). `supabase start` prints both values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Demo project only: shows the "log in as" switcher. Leave unset on the pilot project.
NEXT_PUBLIC_DEMO=1
# NEVER put the service-role key here or in any NEXT_PUBLIC_* variable.
