# Copy to .env.local (never commit it). `supabase start` prints both values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Demo project only: shows the "log in as" switcher. Leave unset on the pilot project.
# Uncomment locally only; off by default so a copied env never enables known-password demo logins.
# NEXT_PUBLIC_DEMO=1
# NEVER put the service-role key here or in any NEXT_PUBLIC_* variable.
# The AI column-mapping key is not set here either; it is an edge-function secret:
#   local: ANTHROPIC_API_KEY=... in supabase/functions/.env (gitignored), then `npx supabase functions serve`
#   cloud: npx supabase secrets set ANTHROPIC_API_KEY=...
